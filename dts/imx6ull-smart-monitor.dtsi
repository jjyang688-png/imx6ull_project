/ {
  /* ========== LED 驱动 (CDEV) ========== */
  comp_drv_dev {
    compatible = "smartmonitor,comp-drv";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_led>;          /* ← 引用已有的引脚配置 */
    led-gpios = <&gpio1 3 GPIO_ACTIVE_LOW>;
    status = "okay";
  };
  
  /* ========== 按键输入驱动 (Input + IRQ) ========== */
  key_input_dev {
    compatible = "smartmonitor,key-input";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_key>;          /* ← 引用已有的引脚配置 */
    key-gpios = <&gpio1 18 GPIO_ACTIVE_LOW>;
    interrupt-parent = <&gpio1>;
    interrupts = <18 IRQ_TYPE_EDGE_BOTH>;
    key-code = <28>;
    debounce-interval = <20>;
    status = "okay";
  };
  
  /* ========== UART3 命令控制台（Phase 7） ==========
   *
   * UART3 硬件资源：
   *   基地址：0x021ec000（来自 imx6ull.dtsi 的 uart3 节点）
   *   中断号：GIC_SPI 28（Linux IRQ = 32+28 = 60）
   *   时钟：  IMX6UL_CLK_UART3_IPG + IMX6UL_CLK_UART3_SERIAL
   *
   * 注意：&uart3 已设为 disabled，防止 imx 驱动抢占资源。
   */
  uart_sensor_dev: uart_sensor_dev {
    compatible = "smartmonitor,uart-sensor";
    reg = <0x021ec000 0x4000>;
    interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
    interrupt-parent = <&intc>;
    clocks = <&clks IMX6UL_CLK_UART3_IPG>,
             <&clks IMX6UL_CLK_UART3_SERIAL>;
    clock-names = "ipg", "per";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_uart3>;
    current-speed = <115200>;
    status = "okay";
  };
  
};


/* ========== I2C1 — AP3216C 光照/接近传感器 ========== */
&i2c1 {
  ap3216c: ap3216c@1e {
    compatible = "smartmonitor,ap3216c";
    reg = <0x1e>;
  };
};

  /* ========== ECSPI3 — ICM20608 6轴传感器 ========== */
&ecspi3 {
  icm20608: icm20608@0 {
    compatible = "smartmonitor,icm20608";
    reg = <0>;   //这个reg为片选地址
    spi-max-frequency = <8000000>;   /* 8 MHz */
  };
};

/* ========== UART3 — 启用内核 imx-uart 驱动 (ttymxc2) ========== */
&uart3 {
    status = "okay";  /* 使用内核 imx-uart 驱动，设备文件 /dev/ttymxc2 */
};

/* 禁用 UART2 — 释放 UART3_TX/RX 引脚（被 UART2 流控占用） */
&uart2 {
    status = "disabled";
};

/* 禁用 FLEXCAN1 — 释放 UART3_RTS/CTS 引脚 */
&flexcan1 {
    status = "disabled";
};

/* 禁用自定义 uart_sensor_dev — 与 &uart3 的 reg 冲突 */
&uart_sensor_dev {
    status = "disabled";
};